# ══════════════════════════════════════════════════════════════
# E2E test credentials — คัดลอกเป็น .env.local แล้วแก้ค่า
# ⚠️ ห้าม commit ไฟล์ .env.local (อยู่ใน .gitignore แล้ว)
# ══════════════════════════════════════════════════════════════

# URL ของเว็บที่จะทดสอบ (ค่าเริ่มต้น: Vite dev server)
E2E_BASE_URL=http://localhost:5173

# บัญชีที่ใช้ทดสอบ (ต้องมีอยู่จริงใน DB)
E2E_ADMIN_EMAIL=admin@amlo.go.th
E2E_ADMIN_PASSWORD=

E2E_SUPERVISOR_EMAIL=supervisor@amlo.go.th
E2E_SUPERVISOR_PASSWORD=

# ถ้าบัญชีทดสอบเปิด 2FA อยู่ ต้องใส่ base32 secret เพื่อให้เทสต์กรอก OTP ได้เอง
# (ดึงได้จากตาราง User คอลัมน์ twoFactorSecret — ใช้เฉพาะเครื่องทดสอบเท่านั้น)
E2E_TOTP_SECRET=
